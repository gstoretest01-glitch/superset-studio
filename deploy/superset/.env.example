# Sao chép thành .env trong cùng thư mục (deploy/superset/) trước khi chạy docker compose.

# Bắt buộc — tạo bằng: openssl rand -base64 42
SUPERSET_SECRET_KEY=

# Tuỳ chọn — chỉ cần khi dùng render_mode = 'iframe' (P1.4). Tạo bằng: openssl rand -base64 42
GUEST_TOKEN_JWT_SECRET=

# Domain của app Report Studio (dùng cho CORS + CSP frame-ancestors)
APP_DOMAIN=http://localhost:8080

# Mật khẩu Postgres nội bộ (container db), không cần mạnh vì không expose ra ngoài
POSTGRES_PASSWORD=superset

# Tài khoản admin Superset (đăng nhập UI http://localhost:8088)
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_ADMIN_PASSWORD=change-me-admin-pass

# Tài khoản dịch vụ (role Gamma) mà Report Studio dùng để gọi REST API
SUPERSET_SERVICE_USERNAME=report_studio_svc
SUPERSET_SERVICE_EMAIL=report-studio-svc@example.com
SUPERSET_SERVICE_PASSWORD=change-me-service-pass
